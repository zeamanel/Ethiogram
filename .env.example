# ── Environment ────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── Security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-generate-a-random-32-char-string
ENCRYPTION_KEY=change-me-generate-a-random-32-char-string
WEBHOOK_SECRET_SALT=change-me-generate-a-random-string

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ethiogram
DATABASE_POOL_SIZE=20
DATABASE_ECHO=false

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Google Cloud ───────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_NAME=ethiogram-uploads
GCS_BUCKET_PUBLIC=ethiogram-public
# Path to service account JSON (local dev only — use Workload Identity in prod)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Vertex AI ──────────────────────────────────────────────────────────────
VERTEX_AI_LOCATION=us-central1
# VERTEX_AI_PROJECT=  # defaults to GCP_PROJECT_ID

# ── Master Bot (@ethiogram_bot) ────────────────────────────────────────────
MASTER_BOT_TOKEN=your-master-bot-token-from-botfather
MASTER_BOT_USERNAME=ethiogram_bot
MASTER_BOT_WEBHOOK_URL=https://api.ethiogram.com/webhook/master

# ── Platform URLs ──────────────────────────────────────────────────────────
BASE_URL=https://api.ethiogram.com
DASHBOARD_URL=https://ethiogram.com/dashboard
MINI_APP_URL=https://ethiogram.com/app
BIZ_PAGE_URL=https://ethiogram.com/biz

# ── AI Models ──────────────────────────────────────────────────────────────
DEFAULT_MODEL_ID=gemini-2.0-flash-001
FALLBACK_MODEL_ID=gpt-4o-mini
EMERGENCY_MODEL_ID=llama-3.1-8b-instruct
EMBEDDING_MODEL_ID=text-embedding-004

# ── OpenAI (fallback) ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# OPENAI_ORG_ID=org-...
# Point at any OpenAI-compatible endpoint (e.g. OpenRouter). Leave unset for OpenAI.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ── Anthropic (premium) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── ETG Token Economy ──────────────────────────────────────────────────────
ETG_USD_RATE=0.01
ETG_ETB_RATE=0.56
ETG_NEW_USER_BONUS=100
ETG_REFERRAL_BONUS=200

# ── Chapa (Ethiopian payments) ─────────────────────────────────────────────
CHAPA_SECRET_KEY=CHASECK_...
CHAPA_PUBLIC_KEY=CHAPUBK_...
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── PayPal ─────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com  # sandbox

# ── NOWPayments (crypto) ───────────────────────────────────────────────────
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-ipn-secret

# ── LemonSqueezy ───────────────────────────────────────────────────────────
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret

# ── Google Calendar (Concierge Agent) ─────────────────────────────────────
# JSON string of service account credentials
# GOOGLE_CALENDAR_CREDENTIALS={"type":"service_account",...}

# ── Firebase (Live Commerce) ───────────────────────────────────────────────
# FIREBASE_PROJECT_ID=your-firebase-project
# FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ── Admin ──────────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs of super-admins
ADMIN_TELEGRAM_IDS=[123456789]
ADMIN_EMAIL=admin@ethiogram.com
ADMIN_SECRET_HEADER=your-secret-admin-header-value

# ── Platform limits ────────────────────────────────────────────────────────
MAX_FILE_UPLOAD_MB=50
MAX_BOTS_PER_BUSINESS=5
TRIAL_DURATION_DAYS=15
ESCROW_RELEASE_DAYS=7
GRACE_PERIOD_HOURS=24

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WEBHOOK_PER_SECOND=100
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# ── Sentry (optional) ──────────────────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...
